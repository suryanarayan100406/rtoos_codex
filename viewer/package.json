{
  "name": "drishti-survey-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:coordinates": "node scripts/coordinates.cjs",
    "test:semantics": "node scripts/semantics.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "cesium": "1.124.0",
    "proj4": "2.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/proj4": "2.5.6",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.1",
    "vite-plugin-static-copy": "2.3.2"
  },
  "overrides": {
    "@cesium/engine": "13.1.0",
    "@cesium/widgets": "10.0.0",
    "@zip.js/zip.js": "2.7.54"
  }
}
